\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Ways to summarise the empirical per-mission damage-increment distribution and propagate it to the accumulated damage $D = \DOTSB \sum@ \slimits@ _t \Delta D_t$ for the constraint $\Pr (D > \tau ) \le \varepsilon $. ``Conservative'' means a guaranteed upper bound on the failure probability (Route~I) or $\le _{\mathrm  {st}}$ dominance (Route~II); ``$\setbox \z@ \hbox {\mathsurround \z@ $\textstyle D$}\mathaccent "0365{D}$'' means the method yields an explicit surrogate \emph  {law} for the sum, as opposed to a one-sided bound. All inputs are \emph  {per mission}; the schedule combines them through the assignment counts $n_{ij}$ by Equation~\eqref  {eq:additive_functionals}. Only the closed form of Bernstein's inequality merges the supports into one constant $b_\ell $, the largest of them. CGF: cumulant generating function; var: variance.}}{22}{table.7}\protected@file@percent }
\newlabel{tab:cons_surrogates}{{7}{22}{Ways to summarise the empirical per-mission damage-increment distribution and propagate it to the accumulated damage $D = \sum _t \Delta D_t$ for the constraint $\Pr (D > \tau ) \le \varepsilon $. ``Conservative'' means a guaranteed upper bound on the failure probability (Route~I) or $\le _{\mathrm {st}}$ dominance (Route~II); ``$\widetilde {D}$'' means the method yields an explicit surrogate \emph {law} for the sum, as opposed to a one-sided bound. All inputs are \emph {per mission}; the schedule combines them through the assignment counts $n_{ij}$ by Equation~\eqref {eq:additive_functionals}. Only the closed form of Bernstein's inequality merges the supports into one constant $b_\ell $, the largest of them. CGF: cumulant generating function; var: variance}{table.7}{}}
